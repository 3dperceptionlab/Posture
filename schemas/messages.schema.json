{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:posture:message:0.1",
  "title": "POSTURE ROS/API messages — proposed v0.1",
  "oneOf": [
    {
      "$ref": "#/$defs/telemetry"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/profile_application"
    },
    {
      "$ref": "#/$defs/shift_assessment"
    }
  ],
  "$defs": {
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "detected",
            "estimated",
            "missing"
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "image_xy_px": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "point_3d_m": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "confidence",
        "image_xy_px",
        "point_3d_m"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "image_xy_px": {
                "type": "null"
              },
              "point_3d_m": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "detected",
                  "estimated"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "image_xy_px": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              {
                "properties": {
                  "point_3d_m": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "cell_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "operator_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "study_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "emitted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "clock_sync": {
          "enum": [
            "synchronized",
            "unsynchronized",
            "unknown"
          ]
        },
        "message_type": {
          "const": "telemetry"
        },
        "pose": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "observed_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "frame_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "camera_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "tracking_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cycle_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "joint_schema": {
                  "const": "posture.body33.v1"
                },
                "estimator": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "name",
                    "version"
                  ]
                },
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "width_px": {
                      "const": 1920
                    },
                    "height_px": {
                      "const": 1080
                    },
                    "mirrored": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "width_px",
                    "height_px",
                    "mirrored"
                  ]
                },
                "calibration_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "space_3d": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "enum": [
                            "model_relative",
                            "camera_metric",
                            "world_metric"
                          ]
                        },
                        "frame_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "unit": {
                          "const": "m"
                        },
                        "accuracy": {
                          "enum": [
                            "unvalidated",
                            "validated"
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "frame_id",
                        "unit",
                        "accuracy"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "joints": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "nose": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_eye_inner": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_eye": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_eye_outer": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_eye_inner": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_eye": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_eye_outer": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_ear": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_ear": {
                      "$ref": "#/$defs/joint"
                    },
                    "mouth_left": {
                      "$ref": "#/$defs/joint"
                    },
                    "mouth_right": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_shoulder": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_shoulder": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_elbow": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_elbow": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_wrist": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_wrist": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_pinky": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_pinky": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_index": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_index": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_thumb": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_thumb": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_hip": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_hip": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_knee": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_knee": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_ankle": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_ankle": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_heel": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_heel": {
                      "$ref": "#/$defs/joint"
                    },
                    "left_foot_index": {
                      "$ref": "#/$defs/joint"
                    },
                    "right_foot_index": {
                      "$ref": "#/$defs/joint"
                    }
                  },
                  "required": [
                    "nose",
                    "left_eye_inner",
                    "left_eye",
                    "left_eye_outer",
                    "right_eye_inner",
                    "right_eye",
                    "right_eye_outer",
                    "left_ear",
                    "right_ear",
                    "mouth_left",
                    "mouth_right",
                    "left_shoulder",
                    "right_shoulder",
                    "left_elbow",
                    "right_elbow",
                    "left_wrist",
                    "right_wrist",
                    "left_pinky",
                    "right_pinky",
                    "left_index",
                    "right_index",
                    "left_thumb",
                    "right_thumb",
                    "left_hip",
                    "right_hip",
                    "left_knee",
                    "right_knee",
                    "left_ankle",
                    "right_ankle",
                    "left_heel",
                    "right_heel",
                    "left_foot_index",
                    "right_foot_index"
                  ]
                }
              },
              "required": [
                "observed_at",
                "frame_id",
                "camera_id",
                "tracking_id",
                "cycle_id",
                "joint_schema",
                "estimator",
                "image",
                "calibration_id",
                "space_3d",
                "joints"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "robot": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "observed_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "cycle_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "model": {
                  "const": "UR3"
                },
                "joint_names": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "minItems": 6,
                  "maxItems": 6,
                  "uniqueItems": true
                },
                "joint_positions_rad": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 6,
                  "maxItems": 6
                },
                "tcp_pose": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "frame_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "position_m": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "orientation_xyzw": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      },
                      "required": [
                        "frame_id",
                        "position_m",
                        "orientation_xyzw"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "robot_mode": {
                  "enum": [
                    "idle",
                    "moving",
                    "paused",
                    "fault",
                    "unknown"
                  ]
                },
                "safety_status": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "applied_profile_revision": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "suction": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "commanded_active": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "feedback_available": {
                      "const": false
                    },
                    "measured_active": {
                      "type": "null"
                    },
                    "last_command_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "last_command_source": {
                      "enum": [
                        "voice",
                        "hmi",
                        "ros",
                        "unknown",
                        null
                      ]
                    },
                    "last_command_at": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "Z$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "commanded_active",
                    "feedback_available",
                    "measured_active",
                    "last_command_id",
                    "last_command_source",
                    "last_command_at"
                  ]
                }
              },
              "required": [
                "observed_at",
                "cycle_id",
                "model",
                "joint_names",
                "joint_positions_rad",
                "tcp_pose",
                "robot_mode",
                "safety_status",
                "applied_profile_revision",
                "suction"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "table": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "observed_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "height_m": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "height_reference": {
                  "const": "tabletop_above_floor"
                },
                "state": {
                  "enum": [
                    "idle",
                    "moving",
                    "fault",
                    "unknown"
                  ]
                },
                "applied_profile_revision": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "observed_at",
                "height_m",
                "height_reference",
                "state",
                "applied_profile_revision"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "frame": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frame_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "camera_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "captured_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "width_px": {
                  "const": 1920
                },
                "height_px": {
                  "const": 1080
                },
                "capture_fps": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 240
                },
                "retention_mode": {
                  "enum": [
                    "transient",
                    "study"
                  ]
                },
                "content_type": {
                  "const": "image/jpeg"
                }
              },
              "required": [
                "frame_id",
                "camera_id",
                "captured_at",
                "width_px",
                "height_px",
                "capture_fps",
                "retention_mode",
                "content_type"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "source_id",
        "boot_id",
        "sequence",
        "cell_id",
        "session_id",
        "operator_id",
        "study_id",
        "emitted_at",
        "clock_sync",
        "message_type",
        "pose",
        "robot",
        "table",
        "frame"
      ],
      "anyOf": [
        {
          "properties": {
            "pose": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "robot": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "table": {
              "type": "object"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "frame": {
                "type": "object",
                "properties": {
                  "retention_mode": {
                    "const": "study"
                  }
                },
                "required": [
                  "retention_mode"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "study_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "cell_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "operator_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "study_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "emitted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "clock_sync": {
          "enum": [
            "synchronized",
            "unsynchronized",
            "unknown"
          ]
        },
        "message_type": {
          "const": "event"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "cycle_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "event_type": {
          "enum": [
            "session_started",
            "session_ended",
            "cycle_started",
            "cycle_completed",
            "cycle_cancelled",
            "phase_started",
            "phase_ended",
            "handover_reported",
            "suction_commanded",
            "operator_changed",
            "diagnostic"
          ]
        },
        "origin": {
          "enum": [
            "ros_state",
            "voice",
            "hmi",
            "manual",
            "inferred"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "source_id",
        "boot_id",
        "sequence",
        "cell_id",
        "session_id",
        "operator_id",
        "study_id",
        "emitted_at",
        "clock_sync",
        "message_type",
        "observed_at",
        "cycle_id",
        "event_type",
        "origin",
        "reason",
        "data"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "enum": [
                  "cycle_started",
                  "cycle_completed",
                  "cycle_cancelled",
                  "phase_started",
                  "phase_ended",
                  "handover_reported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cycle_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "enum": [
                  "phase_started",
                  "phase_ended"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "phase": {
                    "enum": [
                      "robot_pick",
                      "robot_present",
                      "human_transfer",
                      "manual_finishing",
                      "part_place",
                      "idle"
                    ]
                  },
                  "phase_instance_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "phase",
                  "phase_instance_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "cycle_completed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "outcome": {
                    "enum": [
                      "finished_uninspected",
                      "accepted",
                      "rejected",
                      "rework",
