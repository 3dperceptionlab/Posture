POSTURE_PORT=8080
POSTURE_BIND=0.0.0.0
POSTURE_ADMIN_USER=admin
POSTURE_ADMIN_PASSWORD=replace-with-a-long-random-password
POSTURE_INGEST_TOKEN=replace-with-a-separate-long-random-token
# strict requires credentials; development allows anonymous administrator API access.
POSTURE_AUTH_MODE=strict
POSTURE_COOKIE_SECURE=false
POSTURE_TLS_HOST=172.19.33.30
POSTURE_TLS_EXTRA_HOST=100.82.238.105
POSTURE_TLS_PORT=8443
# Index or UUID of the NVIDIA GPU; current Clarke RTX 4090 is device 0.
POSTURE_GPU_DEVICE=0
